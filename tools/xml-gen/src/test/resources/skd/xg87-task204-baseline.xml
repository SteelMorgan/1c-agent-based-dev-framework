  xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSet xsi:type="DataSetObject">
		<name>Соседний</name>
		<field xsi:type="DataSetFieldField"><dataPath>Аккаунт</dataPath><field>Аккаунт</field></field>
		<objectName>Соседний</objectName>
	</dataSet>
	<dataSet xsi:type="DataSetObject">
		<name>ДвиженияКапитала</name>
		<field xsi:type="DataSetFieldField"><dataPath>Дата</dataPath><field>Дата</field></field>
		<field xsi:type="DataSetFieldField"><dataPath>Аккаунт</dataPath><field>Аккаунт</field></field>
		<field xsi:type="DataSetFieldField"><dataPath>Портфель</dataPath><field>Портфель</field></field>
