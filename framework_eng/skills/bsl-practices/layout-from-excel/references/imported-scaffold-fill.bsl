// Обобщённый пример честного использования imported MXL как визуального каркаса.
// Показывает два проверенных runtime-паттерна:
//   1) отчёт на импортированном каркасе с ручной записью данных по координатам;
//   2) печатная форма на том же каркасе (отключение сетки, печатные подписи).
//
// Ключевая граница: imported MXL НЕ становится декларативным СКД-макетом и не
// создаёт именованные области. Данные привязываются к ячейкам кодом, итоги
// считаются платформой, а не Excel-формулами (формулы при импорте превращаются
// в зафиксированные значения).

#Область ПрограммныйИнтерфейс

// Заполняет импортированный каркас реальными строками данных.
//
// Контракт вызова: каркас уже прочитан из Excel, шапка и служебные строки
// занимают фиксированные строки сверху, строки данных начинаются с
// ПерваяСтрокаДанных. Демонстрационные строки шаблона перезаписываются
// реальными данными в тех же координатах.
//
// Параметры:
//   ТабДок             - ТабличныйДокумент - прочитанный из Excel каркас.
//   СтрокиДанных       - Массив из Структура - строки данных; ключи структуры
//                        совпадают с именами в МассивКолонок.
//   МассивКолонок      - Массив из Строка - порядок колонок каркаса слева направо;
//                        каждый элемент — ключ структуры строки данных.
//   ПерваяСтрокаДанных - Число - номер первой строки данных в каркасе.
//
Процедура ЗаполнитьСтрокиНаКаркасе(ТабДок, СтрокиДанных, МассивКолонок, ПерваяСтрокаДанных) Экспорт

	Для Индекс = 0 По СтрокиДанных.Количество() - 1 Цикл
		НомерСтроки = ПерваяСтрокаДанных + Индекс;
		СтрокаДанных = СтрокиДанных[Индекс];

		Для НомерКолонки = 1 По МассивКолонок.Количество() Цикл
			ИмяПоля = МассивКолонок[НомерКолонки - 1];
			Значение = СтрокаДанных[ИмяПоля];

			// Числа пишем как Значение (сохраняет тип и формат ячейки),
			// остальное — как Текст.
			Если ТипЗнч(Значение) = Тип("Число") Тогда
				ТабДок.Область(НомерСтроки, НомерКолонки).Значение = Значение;
			Иначе
				ТабДок.Область(НомерСтроки, НомерКолонки).Текст = Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Записывает строку итогов, посчитанных платформенным кодом.
// Итоги НЕ берутся из Excel-формул шаблона: после импорта формул нет,
// есть только последние вычисленные значения. Поэтому итог считается
// по массиву данных и записывается в заранее известную строку.
//
// Параметры:
//   ТабДок        - ТабличныйДокумент - каркас.
//   НомерСтроки   - Число - строка итогов в каркасе.
//   Подпись       - Строка - текст в первой колонке строки итогов.
//   Итоги         - Соответствие - ключ = номер колонки, значение = итог.
//
Процедура ЗаписатьИтоговуюСтроку(ТабДок, НомерСтроки, Подпись, Итоги) Экспорт

	ТабДок.Область(НомерСтроки, 1).Текст = Подпись;

	Для Каждого Пара Из Итоги Цикл
		ТабДок.Область(НомерСтроки, Пара.Ключ).Значение = Пара.Значение;
	КонецЦикла;

КонецПроцедуры

// Переписывает служебные подписи каркаса под честное описание маршрута.
// Важно для приёмки: proof должен видеть, что каркас импортирован, а данные
// привязаны вручную, а не выведены декларативным макетом.
//
// Параметры:
//   ТабДок          - ТабличныйДокумент - каркас.
//   СтрокаЗаголовок - Число - строка заголовка.
//   Заголовок       - Строка - новый заголовок.
//   СтрокаПодпись   - Число - строка служебной подписи.
//   Подпись         - Строка - текст подписи, например "Импорт Excel -> MXL,
//                     ручная привязка runtime-данных".
//
Процедура ПереписатьСлужебныеПодписи(ТабДок, СтрокаЗаголовок, Заголовок, СтрокаПодпись, Подпись) Экспорт

	ТабДок.Область(СтрокаЗаголовок, 1).Текст = Заголовок;
	ТабДок.Область(СтрокаПодпись, 1).Текст = Подпись;

КонецПроцедуры

// Переводит каркас в режим печатной формы: скрывает сетку табличного
// документа, чтобы результат выглядел как печатный лист, а не редактор Excel.
//
// Параметры:
//   ТабДок - ТабличныйДокумент - каркас.
//
Процедура ВключитьРежимПечатнойФормы(ТабДок) Экспорт

	ТабДок.ОтображатьСетку = Ложь;

КонецПроцедуры

#КонецОбласти
