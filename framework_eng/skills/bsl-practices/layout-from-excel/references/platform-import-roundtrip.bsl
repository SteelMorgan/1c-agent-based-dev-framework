// Обобщённый пример платформенного маршрута Excel -> ТабличныйДокумент -> MXL/XLSX.
// Собран по проверенному runtime-эксперименту на платформе 8.3.27.
// Все пути передаются параметрами: в боевом коде источник Excel и каталог
// артефактов определяет прикладной сценарий.

#Область ПрограммныйИнтерфейс

// Читает Excel в ТабличныйДокумент и сохраняет результат в MXL и XLSX.
//
// Параметры:
//   ПутьКИсходномуExcel - Строка - путь к .xlsx, доступный с той стороны,
//                                 где выполняется код (для клиентского
//                                 импорта — путь на клиенте).
//   КаталогАртефактов   - Строка - каталог, куда писать MXL/XLSX.
//   БазовоеИмяФайла     - Строка - имя результата без расширения.
//
// Возвращаемое значение:
//   Структура - ПутьMXL, ПутьXLSX, ТабличныйДокумент.
//
Функция ИмпортироватьExcelИСохранить(ПутьКИсходномуExcel, КаталогАртефактов, БазовоеИмяФайла) Экспорт

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ПутьКИсходномуExcel);

	СоздатьКаталог(КаталогАртефактов);

	ПутьMXL = КаталогАртефактов + "/" + БазовоеИмяФайла + ".mxl";
	ПутьXLSX = КаталогАртефактов + "/" + БазовоеИмяФайла + ".xlsx";

	ТабличныйДокумент.Записать(ПутьMXL, ТипФайлаТабличногоДокумента.MXL);
	ТабличныйДокумент.Записать(ПутьXLSX, ТипФайлаТабличногоДокумента.XLSX);

	Результат = Новый Структура;
	Результат.Вставить("ПутьMXL", ПутьMXL);
	Результат.Вставить("ПутьXLSX", ПутьXLSX);
	Результат.Вставить("ТабличныйДокумент", ТабличныйДокумент);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Восстанавливает в ТабличномДокументе те свойства Excel-геометрии, которые
// платформенный импорт выразить не смог или исказил.
//
// Мотивация: Excel и MXL используют разные шкалы ширины колонок; высоты строк
// и числовые форматы частично теряются при Прочитать(). Экспериментально
// подтверждено: импорт сохраняет сетку, объединения, заливки, шрифты и границы,
// но ширины колонок приходится перезадавать в шкале MXL.
//
// Коэффициент 0.864 — эмпирический перевод ширины колонки Excel (в символах
// шрифта по умолчанию) в ширину колонки MXL, откалиброванный на round-trip
// одного реального шаблона. Для другого шаблона коэффициент нужно
// перекалибровать: сравнить визуально/по ширине результата.
//
// Параметры:
//   ТабДок       - ТабличныйДокумент - уже прочитанный из Excel документ.
//   ШириныExcel  - Массив из Число   - ширины колонок исходного листа по порядку.
//   ВысотыExcel  - Массив из Число   - высоты строк исходного листа по порядку.
//
Процедура ВосстановитьГеометриюExcel(ТабДок, ШириныExcel, ВысотыExcel) Экспорт

	Для НомерКолонки = 1 По ШириныExcel.Количество() Цикл
		ТабДок.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = ШириныExcel[НомерКолонки - 1] * 0.864;
	КонецЦикла;

	Для НомерСтроки = 1 По ВысотыExcel.Количество() Цикл
		ОбластьСтроки = ТабДок.Область(НомерСтроки, , НомерСтроки);
		ОбластьСтроки.АвтоВысотаСтроки = Ложь;
		ОбластьСтроки.ВысотаСтроки = ВысотыExcel[НомерСтроки - 1];
	КонецЦикла;

КонецПроцедуры

// Задаёт числовой формат диапазону ячеек импортированного документа.
// Формулы Excel при импорте превращаются в уже вычисленные значения, а часть
// number formats упрощается — формат нужно перезадавать явно.
//
// Параметры:
//   ТабДок          - ТабличныйДокумент - прочитанный из Excel документ.
//   СтрокаНачало    - Число - первая строка диапазона.
//   Колонка         - Число - колонка диапазона.
//   СтрокаОкончание - Число - последняя строка диапазона.
//   ФорматСтрока    - Строка - форматная строка 1С, например "ЧГ=0; ЧДЦ=8; ЧН=0".
//
Процедура ВосстановитьФорматДиапазона(ТабДок, СтрокаНачало, Колонка, СтрокаОкончание, ФорматСтрока) Экспорт

	ТабДок.Область(СтрокаНачало, Колонка, СтрокаОкончание, Колонка).Формат = ФорматСтрока;

КонецПроцедуры

#КонецОбласти
